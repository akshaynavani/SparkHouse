# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=sparkhouse
CLICKHOUSE_USER=sparkhouse
CLICKHOUSE_PASSWORD=change-me

# Spark
SPARK_MASTER=local[*]
SPARK_WORKER_MEMORY=4G
SPARK_WORKER_CORES=4
SPARKHOUSE_DATA_DIR=./data
# JDBC driver pulled via --packages at submit time
CLICKHOUSE_JDBC_PACKAGE=com.clickhouse:clickhouse-jdbc:0.6.3
